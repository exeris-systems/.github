<?xml version="1.0"?>
<!DOCTYPE module PUBLIC "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN" "https://checkstyle.org/dtds/configuration_1_3.dtd">
<!--
  Exeris Javadoc Checkstyle modules — ADR-085 §F.21, javadoc-conventions.md rules 1–5.
  Modelled on spring-framework/src/checkstyle/checkstyle.xml (Apache-2.0). Do NOT copy this file into
  a repository: workflows/javadoc-gate.yml reads it from the bundle checkout, and runs it on the
  engine pinned in java/checkstyle-engine-pom.xml. Which modules it applies to is the caller's
  `modules` (in full) and `diff-modules` (changed files only) — javadoc-conventions.md rule 11.
-->
<module name="Checker">
  <property name="severity" value="error"/>
  <!-- The gate hands this ruleset a directory in whole-module mode, and Checkstyle audits every file
       it finds there unless told otherwise. A Javadoc ruleset has nothing to say about a .properties
       file, and one audited anyway is a finding on a file no pull request changed. -->
  <property name="fileExtensions" value="java"/>
  <!-- No SuppressionFilter. The obvious form of one names ${config_loc}, and Checkstyle refuses to
       parse a config whose ${config_loc} is unset — which it is whenever the plugin is pointed at a
       config outside the project, i.e. exactly how this file is used. `optional="true"` does not
       help: the failure is in parsing the config, before the file is looked for. Reintroduce with an
       absolute path passed by the caller if suppressions are ever needed. -->
  <!-- rule 5: @author / @version are banned — Git is the author record (Netty, Quarkus) -->
  <module name="RegexpSingleline">
    <property name="format" value="^\s*\*\s*@(author|version)\b"/>
    <property name="message" value="@author/@version are banned (javadoc-conventions.md rule 5) — Git is the author record"/>
  </module>
  <!-- rule 4: @since is major.minor, never major.minor.patch (Spring's atSinceVersionConvention) -->
  <module name="RegexpSingleline">
    <property name="format" value="@since\s+\d+\.\d+\.\d+"/>
    <property name="message" value="@since uses major.minor (e.g. 0.12), not major.minor.0 (javadoc-conventions.md rule 4)"/>
  </module>
  <!-- rule 8: no <pre> @code example blocks - use the @snippet tag.
       No braces in the message below, deliberately: Checkstyle renders a violation message
       through MessageFormat, which reads a brace group as an argument index. A message quoting
       the tag it recommends threw `can't parse argument number: @snippet` and aborted the whole
       audit after two files - which is what made this ruleset look like it found nothing. -->
  <module name="RegexpMultiline">
    <property name="format" value="&lt;pre&gt;\s*\{@code"/>
    <property name="message" value="Use the @snippet tag for examples, not a &lt;pre&gt; @code block (javadoc-conventions.md rule 8)"/>
  </module>
  <!-- rule 12: a doc comment states the contract as it is today. Warning, not error, and on purpose:
       whether a sentence is archaeology or a legitimate statement about the present is a judgement a
       reviewer makes, not a regex.

       The token list is narrow by measurement, not by taste. Rule 12 as drafted named
       `previously|used to|fixed in|no longer|historically`; run literally over exeris-kernel-spi that
       fires 36 times, 21 of them on `no longer` alone - "the buffer is no longer valid after close()",
       "no longer accept work", "no longer writable". Those are correct sentences about the current
       contract, and a check that is wrong twenty times out of twenty-one is a check people learn to
       ignore. Anchoring each token to the verb that makes it past-referential brings the same corpus
       to 2 hits, both genuine: a paragraph narrating a downstream incident, and a before-and-after
       account of a compile-time guarantee that was lost.

       So `no longer` and a bare `previously` are deliberately NOT matched. Their archaeological use
       exists and this will miss it; that is the trade the level and the width are both chosen for. -->
  <module name="RegexpSingleline">
    <property name="severity" value="warning"/>
    <property name="format" value="^\s*\*.*(previously\s+(returned|threw|thrown|was|were|did|had|used|accepted|required|allowed|emitted|read|took|lived|behaved)|(this|it|which|that)\s+used\s+to\s|used\s+to\s+(be|have|read|emit|export|produce|write|generate|return|take|live|sit|do|call|throw|accept|require|spell|prevent|default)|fixed\s+in\s+v?\d|\b(bug|issue|ticket|PR)\s*#\d+|\bformerly\b|\bhistorically\b|(before|after|since)\s+the\s+.{0,40}\b(refactor|rewrite|migration|port)\b|\bas\s+of\s+\d+\.\d|\bwe\s+(hit|had|saw|found|used)\b|workaround\s+for|because\s+of\s+a\s+bug|earlier\s+(version|revision|design|implementation)s?)"/>
    <property name="message" value="Javadoc carries no history (javadoc-conventions.md rule 12). A doc comment states the contract as it is today; the only temporal tags are @since and @deprecated. If this sentence records how something used to be, move it to the release notes or an ADR and reference the ADR with @see. If it is a statement about the present, this is a false positive - say so in review."/>
  </module>
  <module name="TreeWalker">
    <!-- rule 1: presence on public API.

         `exeris.javadocScope` is `public` by default and `protected` when the caller takes rule 1's
         trivial-accessor exemption, and the two values are not a preference. Under `exempt` the gate
         runs javadoc with `-Xdoclint:all,-missing`, because `missing` is the only doclint group that
         reports an undocumented accessor and doclint offers no finer predicate. Dropping the group
         drops it at doclint's DEFAULT VISIBILITY, which is protected — so every missing-doc finding
         above private, not only the ones on the accessors, stops arriving from that half. This scope
         is what picks them back up: measured, `protected` reports an undocumented protected method
         that is not an accessor, and `public` does not reach it.

         On the default policy the scope is `public`. -->
    <module name="MissingJavadocType">
      <property name="scope" value="${exeris.javadocScope}" default="public"/>
      <property name="skipAnnotations" value="Generated"/>
    </module>
    <module name="MissingJavadocMethod">
      <property name="scope" value="${exeris.javadocScope}" default="public"/>
      <property name="allowMissingPropertyJavadoc" value="false"/>
      <!-- These three need no doc comment here, and need no exemption in the OTHER half either:
           doclint's `missing` group does not report an override that inherits documentation, and
           all three inherit java.lang.Object's. Measured — undocumented, they are clean under
           `-Xdoclint:all` and clean here. A bare `toString()` does not redden the gate. -->
      <property name="ignoreMethodNamesRegex" value="^(toString|hashCode|equals)$"/>
      <!-- No minLineCount: this check is strict under both policies, and rule 1's exemption is
           decided by scripts/javadoc_trivial_members.py, which filters THIS check's findings and no
           other. The shapes it accepts are enumerated in its own docstring.

           A line count cannot express the exemption. It counts a body, and an abstract method has
           none, so zero sits under any threshold and every abstract and interface method qualifies.
           Measured on corpora stripped of doc comments, the state in which the exempt set is
           visible at all: `minLineCount=1` releases 689 of 938 public methods on exeris-kernel-spi,
           377 of them abstract contract methods against 29 getters; 55 of 259 on exeris-kernel-tck;
           393 of 447 on exeris-sdk-source-model, the one corpus where the released set resembles
           accessors. The shape predicate releases 29, 11 and 205 on the same three — the 204 fluent
           setters the exemption exists for, plus one getter. -->
    </module>
    <module name="JavadocType">
      <property name="scope" value="${exeris.javadocScope}" default="public"/>
      <property name="allowUnknownTags" value="true"/>
    </module>
    <!-- rule 1 for fields, enum constants and every other variable: OFF by default, on only under
         the trivial-accessor exemption.

         This is the half of rule 1 that Checkstyle never carried, because doclint did. Rule 1 names
         "enum constant and record component", and on a probe with an undocumented public constant and
         an undocumented enum constant `-Xdoclint:all` reports both while the rest of this ruleset
         reports neither. Turning `missing` off without this module would drop those member kinds out
         of the gate entirely — a silent loss of coverage dressed up as an exemption for accessors.
         (A record component is not in that hole: JavadocType already reports a missing @param on the
         record header, measured on the same probe.)

         It is not pure parity, and the difference is in this module's favour: doclint's `missing` does
         not report a constant declared in a RECORD body. Measured on one file carrying the same
         declaration three times — `public static final int` in a class, in a record body, in an
         interface — doclint reports the class and the interface and stays silent on the record,
         while this module reports all three. `exeris-kernel-spi` has six such constants in
         `PersistenceConfig`, public, published and undocumented, that no doclint run has ever named.
         So under the exemption this buys back the group's coverage AND closes a hole in it.

         Switched by severity rather than by scope, and `ignore` by default, so a repository on the
         default policy keeps exactly the gate it had. `JavadocVariable` takes `accessModifiers` and
         NOT `scope` in 13.8.0 — a `scope` property there fails the whole audit with
         "Property 'scope' does not exist". -->
    <module name="JavadocVariable">
      <property name="severity" value="${exeris.memberDocSeverity}" default="ignore"/>
      <property name="accessModifiers" value="public, protected"/>
    </module>
    <!-- rule 3: every parameter, every non-void return, and the throws a caller would catch -->
    <module name="JavadocMethod">
      <property name="accessModifiers" value="${exeris.javadocAccessModifiers}" default="public"/>
      <property name="allowMissingParamTags" value="false"/>
      <property name="allowMissingReturnTag" value="false"/>
      <property name="validateThrows" value="false"/>
      <!-- The default token set includes COMPACT_CTOR_DEF, and on a compact constructor this check
           demands an @param for every record component - tags doclint does not want there and that
           Checkstyle cannot see are already on the record header, where JavadocType requires them.
           A gate whose two halves disagree is not a standard; measured on exeris-sdk, 24 errors,
           all of this shape.

           The trigger is narrow and cost two failed hunts before it was pinned down: the record has
           to be NESTED (exeris-sdk nests them in a sealed interface). A top-level `public record`
           with the identical header, an identically documented compact constructor and the same
           missing tags reports nothing. Anyone re-testing this with a standalone probe will
           conclude the bug does not exist - it does, and the probe has to be nested.

           Nothing is lost. Verified against 13.8.0 with this token set: JavadocType still requires
           @param per component on the record header, JavadocMethod still requires @param on an
           ordinary constructor and @return on a method, and MissingJavadocMethod still requires the
           compact constructor to carry a comment at all. -->
      <property name="tokens" value="METHOD_DEF, CTOR_DEF, ANNOTATION_FIELD_DEF"/>
    </module>
    <!-- rule 2: first sentence present and well-formed -->
    <module name="JavadocStyle">
      <property name="checkFirstSentence" value="true"/>
      <property name="checkEmptyJavadoc" value="true"/>
      <!-- checkHtml is OFF, and nothing is lost by it. Checkstyle's reader does not know that the
           body of {@snippet} is a sample rather than markup, nor that {@code <pre>} is prose about a
           tag: measured on one file, it reports `Extra HTML tag found: </dependency>` inside a
           lang=xml snippet and `Unclosed HTML tag found: <pre>` inside {@code}. Neither can be
           silenced while staying compliant with rule 8, which REQUIRES {@snippet}. 18 such findings
           in exeris-sdk, all unfixable.

           The javadoc half of this gate already checks HTML and does understand both constructs.
           Measured on the same pair of files: `-Xdoclint:all` reports 0 on the snippet file and, on a
           file with genuinely broken markup, `element not closed: b` and `unexpected end tag: </i>`
           as ERRORS. Turning this off removes false positives and no coverage. -->
      <property name="checkHtml" value="false"/>
    </module>
    <module name="NonEmptyAtclauseDescription"/>
    <!-- rule 3: tag order -->
    <module name="AtclauseOrder">
      <property name="tagOrder" value="@param, @return, @throws, @since, @see, @deprecated"/>
      <property name="target" value="CLASS_DEF, INTERFACE_DEF, ENUM_DEF, RECORD_DEF, METHOD_DEF, CTOR_DEF"/>
    </module>
    <module name="JavadocTagContinuationIndentation">
      <property name="offset" value="4"/>
    </module>
    <module name="InvalidJavadocPosition"/>
    <module name="MissingDeprecated"/>
    <!-- rule 6/7 are reviewed, not linted: @implSpec / @apiNote / @implNote usage and the three contract lines
         on buffer/memory/thread types. A Regexp on spi/memory/** for "<b>Allocation:</b>" is the planned L1. -->
  </module>
</module>
